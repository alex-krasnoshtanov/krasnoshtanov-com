---
import { Font } from "astro:assets";
import { projects, briefs } from "../projects";
import "../styles/tokens.css";
import "../styles/site.css";

import manifest from "../../data/manifest.json";
import shadowData from "../../data/shadow.json";
import timelineData from "../../data/emotion-timeline.json";
import platformData from "../../data/cv-platform.json";
import npecData from "../../data/npec.json";

import * as shadow from "../visuals/shadow";
import * as timeline from "../visuals/timeline";
import * as platform from "../visuals/platform";
import * as npec from "../visuals/npec";
import * as arch from "../visuals/arch";

// Every figure is rendered HERE, at build time. That is what makes the page
// work with JavaScript off, and it removes the whole class of "the script
// failed and the visitor sees an empty box" bugs: there is no empty box,
// because the finished drawing is already in the HTML. The pointer handlers
// only move what is already there.
const figures: Record<string, { svg: string; extra?: string; legend?: string }> = {
  shadow: { svg: shadow.render(shadowData as any) },
  timeline: { svg: timeline.render(timelineData as any), legend: timeline.legend() },
  platform: { svg: platform.render(platformData as any), extra: platform.topology() },
  npec: { svg: npec.render(npecData as any), extra: npec.rlStrip(npecData as any) },
};

// How each project leaves the 1240px column. Seven sections at one width read
// as a document rather than a portfolio, and that — not the palette and not
// the motion — was what made the page feel templated.
//
// The shape is chosen by what the figure IS, not to rotate for variety's sake:
//   pin   — the figure holds a full-height stage while its readings pass it
//   rail  — the figure is wider than any screen, so you travel along it
//   split — the figure and the words sit side by side
//
// `shadow` pins because its drawing is a single scene you point a light at.
// `timeline` rails because it is a 3099-unit-wide picture of 52 minutes:
// scrubbing sideways through a recording is what the data already is.
const shapes: Record<string, "pin" | "rail" | "split"> = {
  shadow: "pin",
  timeline: "rail",
  platform: "split",
  npec: "split",
};

const title = "Oleksii Krasnoshtanov";
const description =
  "Applied Data Science & AI. Computer vision, NLP, RAG systems and MLOps — four projects that shipped to someone other than a grader.";
const site = "https://krasnoshtanov.com";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} — computer vision, NLP, MLOps</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={site + "/"} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />

    <meta property="og:type" content="profile" />
    <meta property="og:url" content={site + "/"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="profile:first_name" content="Oleksii" />
    <meta property="profile:last_name" content="Krasnoshtanov" />
    {/*
      No og:image yet, deliberately. A link card with a 404'd image reads
      worse than one with no image. When it is made: put it at public/og.png
      and declare og:image — scripts/check.mjs then enforces that the file
      exists at the declared dimensions.
    */}
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#091018" />

    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-mono" />
  </head>

  <body>
    <div class="progress" aria-hidden="true"></div>
    <div class="cursor" aria-hidden="true"></div>
    <a class="sr-only" href="#work">Skip to the projects</a>

    <header class="shell bar">
      <span class="tag">krasnoshtanov.com</span>
      <span class="tag">evidence regenerated {manifest.generated}</span>
    </header>

    <main>
      <section class="shell hero">
        <h1 class="hero__name">Oleksii Krasnoshtanov</h1>
        <p class="hero__claim">
          <span class="line">I build computer&#8209;vision</span>
          <span class="line">and NLP systems, then</span>
          <span class="line"><em>keep them running</em>.</span>
        </p>
        <p class="hero__lede">
          Third&#8209;year Applied Data Science &amp; AI at Breda University of Applied Sciences.
          Four of the projects below shipped to someone other than a grader.
        </p>
        <nav class="hero__links" aria-label="Elsewhere">
          <a href="/cv.pdf" data-cursor="one page, always current">Résumé</a>
          <a href="https://github.com/alex-krasnoshtanov" data-cursor="the repositories behind this page">GitHub</a>
          <a href="https://linkedin.com/in/oleksii-krasnoshtanov/" data-cursor="oleksii-krasnoshtanov">LinkedIn</a>
          <a href="mailto:oleksiikrasnoshtanov@gmail.com" data-cursor="oleksiikrasnoshtanov@gmail.com">Email</a>
        </nav>
        <p class="tag">Tilburg, Netherlands · 9.1/10 · BUas Scholarship · EN / UK / RU</p>
        <p class="tag hero__cue" aria-hidden="true">seven projects, every number recomputed at build time</p>
      </section>

      <div id="work">
        {
          projects.map((p, i) => {
            const fig = p.visual ? figures[p.visual] : undefined;
            const shape = shapes[p.id] ?? "split";
            const stats = (
              <dl class="stats">
                {p.stats.map((s) => (
                  <div>
                    <dt>{s.label}</dt>
                    <dd
                      data-signal={s.tone === "signal" || undefined}
                      data-warn={s.tone === "warn" || undefined}
                    >
                      {s.value}
                    </dd>
                  </div>
                ))}
              </dl>
            );
            const figure = fig && (
              <figure data-fig={p.id}>
                <Fragment set:html={fig.svg} />
                {fig.extra && <Fragment set:html={fig.extra} />}
                {fig.legend && (
                  <div class="chips">
                    <Fragment set:html={fig.legend} />
                  </div>
                )}
                <figcaption>
                  {p.figNote && <>{p.figNote} · </>}
                  <a href={p.source!.href}>{p.source!.label}</a>
                </figcaption>
              </figure>
            );
            const prose = (
              <>
                {p.body.map((t) => (
                  <p class="project__body">{t}</p>
                ))}
                {p.note && <p class="tag note">{p.note}</p>}
                <p class="tag">
                  <a href={p.repo}>Repository</a>
                </p>
              </>
            );

            const head = (
              <div class="shell">
                <div class="project__head">
                  <span class="project__index">
                    {String(i + 1).padStart(2, "0")} — {p.name}
                  </span>
                  <span class="tag">{p.meta}</span>
                </div>
                <h2 class="project__finding">{p.finding}</h2>
              </div>
            );

            if (shape === "pin") {
              return (
                <section class="project project--pin" id={p.id}>
                  {head}
                  {/*
                    The stage is sticky and the readings are a column beside it
                    that is simply TALLER. No scroll handler decides when to
                    release it: the browser does, because the sticky element
                    stops when its grid row runs out. That is the whole trick.
                  */}
                  <div class="pin">
                    <div class="pin__stage">{figure}</div>
                    <div class="pin__feed">
                      {prose}
                      {stats}
                    </div>
                  </div>
                </section>
              );
            }

            if (shape === "rail") {
              return (
                <section class="project project--travel" id={p.id}>
                  {/*
                    The runway is scroll length and nothing else; the stage is
                    what you look at. On a wide screen the stage pins and the
                    recording travels past a fixed mark, so moving through 52
                    minutes is what moving down the page does.

                    The heading and the legend live INSIDE the stage on purpose.
                    Panning the drawing alone leaves you mid-recording looking
                    at stripes with nothing on screen saying what they are or
                    where you have got to — which is worse than not panning.

                    With no pin — a phone, reduced motion, a browser without
                    scroll-driven animation — none of the CSS below applies and
                    this is the draggable rail it has always been.
                  */}
                  <div class="runway">
                    <div class="stage">
                      {head}
                      <figure class="travel" data-fig={p.id}>
                        <div
                          class="rail"
                          tabindex="0"
                          role="region"
                          aria-label={p.name + " — the recording, end to end"}
                        >
                          <div class="pan">
                            <Fragment set:html={fig!.svg} />
                          </div>
                        </div>
                        <div class="travel__foot shell">
                          {fig!.legend && (
                            <div class="chips">
                              <Fragment set:html={fig!.legend} />
                            </div>
                          )}
                          <figcaption>
                            {p.figNote && <>{p.figNote} · </>}
                            <a href={p.source!.href}>{p.source!.label}</a>
                          </figcaption>
                        </div>
                      </figure>
                    </div>
                  </div>
                  <p class="shell tag rail__hint" aria-hidden="true">drag sideways ⇢</p>
                  <div class="shell project__grid project__grid--wide">
                    <div>{prose}</div>
                    <div>{stats}</div>
                  </div>
                </section>
              );
            }

            return (
              <section class="project project--split" id={p.id}>
                {head}
                {/*
                  Figure and words side by side, the way the pinned section
                  reads. Stacked — a heading, then a full-width panel, then
                  prose arriving underneath — they were three separate objects
                  and the panel cut the section in half.

                  Source order is figure, words, stats, which is the right
                  reading order on one column. On two, the stats move back
                  UNDER the figure rather than sitting beside the prose: the
                  prose column runs much longer than the figure, and with the
                  stats over there too the section ended in 400px of nothing.
                  Split this way the two columns finish within a line of each
                  other, and the stats get the width to stop wrapping.
                */}
                <div class="split">
                  {figure}
                  <div class="split__words">{prose}</div>
                  {stats}
                </div>
              </section>
            );
          })
        }

        {/*
          The last three are short — a paragraph and a pipeline diagram each.
          Stacked vertically they were three more identical bands at the end of
          a page that already had four. Side by side they are one object you
          travel along, and the diagrams finally get to be the width they were
          drawn at. The rail is a plain overflow-x container: the browser's own
          scrolling, so a trackpad, a shift-wheel, a dragged scrollbar, arrow
          keys and a touch swipe all work without a line of JavaScript.
        */}
        <section class="project project--rail" id="briefs">
          <div class="shell">
            <div class="project__head">
              <span class="project__index">
                05—07 — Also shipped
              </span>
              <span class="tag">three shorter ones, side by side</span>
            </div>
            <h2 class="project__finding">Three more that reached someone.</h2>
          </div>

          <div
            class="rail rail--cards"
            tabindex="0"
            role="region"
            aria-label="Three shorter projects — scroll sideways"
          >
            <div class="rail__track">
              {
                briefs.map((b, i) => {
                  const flow = arch.flows[b.id];
                  return (
                    <article class="card" id={b.id}>
                      <div class="project__head">
                        <span class="project__index">
                          {String(projects.length + i + 1).padStart(2, "0")} — {b.name}
                        </span>
                      </div>
                      <p class="tag">{b.meta}</p>
                      <h3 class="card__finding">{b.finding}</h3>
                      <p class="project__body">{b.body}</p>
                      {flow && (
                        <figure data-fig={b.id}>
                          <Fragment set:html={arch.render(flow)} />
                          <figcaption>{flow.note}</figcaption>
                        </figure>
                      )}
                      {b.repo && (
                        <p class="tag card__repo">
                          <a href={b.repo}>Repository</a>
                        </p>
                      )}
                    </article>
                  );
                })
              }
            </div>
          </div>
          <p class="shell tag rail__hint" aria-hidden="true">drag sideways ⇢</p>
        </section>
      </div>
    </main>

    <footer class="shell">
      <p class="tag footer__note">
        Every number here is either recomputed from committed data at build time, or recorded
        in a named file and linked to it. Where a figure I once wrote down turned out to have
        no source, it is gone rather than hedged. The build refuses to publish if that stops
        being true.
      </p>
    </footer>

    <script>
      // ONE pointer handler for the whole page. It writes two numbers to the
      // root and stops; the light, the grid it uncovers, the headline's weight
      // and the cursor label's position are all CSS reading those numbers.
      const root = document.documentElement;
      const cursor = document.querySelector<HTMLElement>(".cursor");
      const fine = matchMedia("(hover: hover)").matches;
      const still = matchMedia("(prefers-reduced-motion: reduce)").matches;

      if (fine && !still) {
        let x = 0.34;
        let y = 0.3;
        let queued = false;
        addEventListener(
          "pointermove",
          (e) => {
            x = e.clientX / innerWidth;
            y = e.clientY / innerHeight;
            if (queued) return;
            queued = true;
            requestAnimationFrame(() => {
              queued = false;
              root.style.setProperty("--mx", x.toFixed(4));
              root.style.setProperty("--my", y.toFixed(4));
            });
          },
          { passive: true },
        );
      }

      // The label rides the cursor instead of living in the layout, so text
      // arriving can never reflow a section. `hold` is what a figure sets
      // while the pointer is inside it; otherwise the nearest data-cursor
      // ancestor supplies the text.
      let hold: string | null = null;
      // WHICH figure is holding, not just that something is. A held reading
      // used to be cleared only by a pointerout on the element that set it,
      // and that event is not guaranteed: scroll a figure out from under a
      // still pointer and no boundary event need fire at all. The reading then
      // outlived the figure it came from and followed the cursor down the rest
      // of the page until some other label happened to replace it.
      let holder: Element | null = null;
      const show = (text: string | null) => {
        if (!cursor || !fine) return;
        if (text) {
          cursor.textContent = text;
          cursor.setAttribute("data-on", "");
        } else {
          cursor.removeAttribute("data-on");
        }
      };
      /** Each figure gets its own labeller, bound to the element it draws in. */
      const labelFor = (el: Element) => (text: string) => {
        holder = el;
        hold = text;
        show(text);
      };

      if (fine) {
        addEventListener(
          "pointerover",
          (e) => {
            const hit = (e.target as Element)?.closest?.("[data-cursor]");
            // The pointer is somewhere else now, so nothing is being held —
            // however the pointer got here, and whether or not the figure it
            // came from ever saw it leave.
            if (hit !== holder) {
              hold = null;
              holder = null;
            }
            // A figure's live reading outranks its element's static label,
            // which also stops "move the light" flickering over the reading
            // every time the pointer crosses a shape inside the drawing.
            show(hold ?? (hit ? hit.getAttribute("data-cursor") : null));
          },
          { passive: true },
        );
        addEventListener(
          "pointerout",
          (e) => {
            const hit = (e.target as Element)?.closest?.("[data-cursor]");
            if (!hit) return;
            if (hit === holder) holder = null;
            hold = null;
            show(null);
          },
          { passive: true },
        );
      }

      // The timeline pins and the recording travels past you. Which mechanism
      // moves it depends on the browser, and this decides which:
      //
      //   native — the browser has scroll-driven animation, so CSS does it on
      //            the compositor and nothing here runs again.
      //   js     — it does not, so one scroll handler writes the same
      //            transform. Firefox has no view-timeline as of today, and a
      //            recruiter opens this page in whatever they already have.
      //
      // Terms are the CSS's: wide screens, and never under reduced motion — a
      // sideways pan driven by vertical scroll is exactly the kind of movement
      // that preference is asking us not to make. With this script blocked,
      // the attribute is never set, the pin never engages, and the section is
      // the draggable rail it is without any of this.
      const runway = document.querySelector<HTMLElement>(".runway");
      const track = runway?.querySelector<HTMLElement>(".pan");

      // One question, asked once, that decides every motion fallback below:
      // does this browser have scroll-driven animation at all? Firefox does
      // not, as of today.
      const native = CSS.supports("animation-timeline", "view()");

      if (runway && track && !still && matchMedia("(min-width: 64rem)").matches) {
        runway.dataset.pan = native ? "native" : "js";

        if (!native) {
          let queued = false;
          const place = () => {
            queued = false;
            // Measured, not computed from --tl-aspect: the element is right
            // there, and a number read off the DOM cannot drift from it.
            const distance = track.scrollWidth - innerWidth;
            const span = runway.offsetHeight - innerHeight;
            if (distance <= 0 || span <= 0) return;
            const through = Math.min(1, Math.max(0, (scrollY - runway.offsetTop) / span));
            track.style.setProperty("transform", `translateX(${(-distance * through).toFixed(1)}px)`);
          };
          addEventListener(
            "scroll",
            () => {
              if (queued) return;
              queued = true;
              requestAnimationFrame(place);
            },
            { passive: true },
          );
          addEventListener("resize", place, { passive: true });
          place();
        }
      }

      // The rest of the motion layer, for browsers without the feature.
      //
      // Every reveal in @layer motion — the rise, the settling headings, the
      // figures developing, the training curve drawing itself — is a
      // scroll-driven animation, so on Firefox none of it happened at all and
      // the page was visibly more alive in Chrome than in Firefox.
      //
      // An observer gives the same states by transition instead. It plays once
      // on arrival rather than scrubbing with the scrollbar, which is a real
      // difference and an invisible one for a fade and a rise.
      if (!native && !still) {
        const root = document.documentElement;
        const seen = (el: Element) => el.setAttribute("data-seen", "");

        // What gets revealed, and how. The CSS has no say in the membership of
        // this list: it styles [data-reveal], which only this loop writes. An
        // earlier version let the stylesheet hide elements BY TYPE while this
        // code skipped some of them, so the skipped ones were hidden by CSS
        // and never revealed by anyone — three card diagrams and the whole
        // timeline, clipped to nothing in Firefox and nowhere else.
        const REVEALS: [string, string][] = [
          [".pf-line", "draw"],
          [".pf-zero, .pf-best", "pop"],
          [".project__finding, .card__finding", "settle"],
          ["figure", "develop"],
          [".project__body, .stats, .note", "rise"],
        ];

        root.dataset.motion = "js";

        const io = new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              obs.unobserve(entry.target);
              seen(entry.target);
            }
          },
          { rootMargin: "0px 0px -10% 0px" },
        );

        // Read every position first, write afterwards. Interleaving them makes
        // the browser re-layout once per element.
        const pending: [HTMLElement, string, boolean][] = [];
        for (const [selector, kind] of REVEALS) {
          for (const el of document.querySelectorAll<HTMLElement>(selector)) {
            // A rail scrolls on its own axis and the pinned timeline already
            // has the pan for its motion. Neither is tagged, so neither can be
            // hidden by anything above.
            if (el.closest(".rail") || el.classList.contains("travel")) continue;
            pending.push([el, kind, el.getBoundingClientRect().top < innerHeight]);
          }
        }

        for (const [el, kind, onScreen] of pending) {
          el.setAttribute("data-reveal", kind);
          // Anything already on screen is marked in the same breath and never
          // hidden. Hiding what someone is already looking at and then
          // revealing it is a flash, and a flash is worse than no animation.
          if (onScreen) seen(el);
          else io.observe(el);
        }

        // The progress bar is the one piece that is not a reveal: it reports
        // position continuously, so it needs the scroll itself, not an
        // observer. CSS reads --scrolled and scales the bar.
        let queued = false;
        const report = () => {
          queued = false;
          const span = document.documentElement.scrollHeight - innerHeight;
          root.style.setProperty("--scrolled", span > 0 ? (scrollY / span).toFixed(4) : "0");
        };
        addEventListener(
          "scroll",
          () => {
            if (queued) return;
            queued = true;
            requestAnimationFrame(report);
          },
          { passive: true },
        );
        report();
      }

      // Which section is the subject, decided by the scroll rather than by
      // where the pointer was last put down. Runs on every browser, because
      // the staleness it fixes is not a missing feature: Chromium re-resolves
      // :hover during a scroll and Firefox does not, so on Firefox the
      // highlight simply stayed behind until the mouse moved.
      //
      // Greatest visible height wins, not "contains the middle of the
      // screen" — a section taller than the viewport would otherwise hand the
      // subject away every time a gap crossed the midpoint.
      if (fine && !still) {
        const attended = [...document.querySelectorAll<HTMLElement>("#work > section.project")];
        if (attended.length) {
          root.dataset.attend = "";
          let pending = false;
          const attend = () => {
            pending = false;
            let subject: HTMLElement | null = null;
            let mostSeen = 0;
            for (const s of attended) {
              const r = s.getBoundingClientRect();
              const visible = Math.min(r.bottom, innerHeight) - Math.max(r.top, 0);
              if (visible > mostSeen) {
                mostSeen = visible;
                subject = s;
              }
            }
            for (const s of attended) s.toggleAttribute("data-current", s === subject);
          };
          addEventListener(
            "scroll",
            () => {
              if (pending) return;
              pending = true;
              requestAnimationFrame(attend);
            },
            { passive: true },
          );
          addEventListener("resize", attend, { passive: true });
          attend();
        }
      }

      // Figures hydrate only when scrolled to, each module its own chunk. If
      // any of this fails the drawing is still there — nothing was removed to
      // make room for it.
      const loaders: Record<string, () => Promise<any>> = {
        shadow: () => import("../visuals/shadow"),
        timeline: () => import("../visuals/timeline"),
        npec: () => import("../visuals/npec"),
      };

      for (const [id, load] of Object.entries(loaders)) {
        const host = document.querySelector(`[data-fig="${id}"]`);
        const svg = host?.querySelector("svg");
        if (!svg) continue;
        new IntersectionObserver(
          (entries, obs) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              obs.disconnect();
              load()
                .then((m) => m.attach(svg as any, labelFor(svg)))
                .catch(() => {
                  /* The static drawing stands. Nothing to recover. */
                });
            }
          },
          { rootMargin: "200px" },
        ).observe(svg);
      }
    </script>
  </body>
</html>
