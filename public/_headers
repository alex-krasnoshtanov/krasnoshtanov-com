/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # No inline scripts and no third-party origins: every asset is same-origin
  # because the fonts are self-hosted. If a visual ever needs an inline
  # script, give it a hash rather than loosening this.
  Content-Security-Policy: default-src 'self'; img-src 'self' data:; style-src 'self'; script-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
